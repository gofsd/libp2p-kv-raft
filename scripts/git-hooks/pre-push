#!/bin/sh
# Runs before every `git push`, once `git config core.hooksPath` points here
# (see `mage githooks:install`). Blocks the push if `mage e2e:current`
# fails -- the rows recorded since the last published testdata.json
# version (see pkg/e2edata.File.PendingRows) -- rather than every row ever
# recorded (`mage e2e:all`), so a routine push isn't slowed down re-running
# the whole history every time.
#
# Set SKIP_E2E=1 to bypass this for a push that genuinely can't reach the
# e2e infrastructure (e.g. no network to the SSH bootstrap host) -- deliberate,
# so the escape hatch is visible in the command line, not a silent --no-verify.

if [ -n "$SKIP_E2E" ]; then
	echo "pre-push: SKIP_E2E set, skipping mage e2e:current"
	exit 0
fi

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

if ! command -v mage >/dev/null 2>&1; then
	echo "pre-push: mage not found on PATH -- install it (see magefile.go) or push with SKIP_E2E=1 git push" >&2
	exit 1
fi

echo "pre-push: running mage e2e:current..."
if ! mage e2e:current; then
	echo "pre-push: mage e2e:current failed -- push blocked. See test/e2e/testdata.json for per-row status/error, or push with SKIP_E2E=1 git push to bypass." >&2
	exit 1
fi

# A successful e2e:current always re-records android_ui_result's own
# ran_at/status in test/e2e/testdata.json (see pkg/e2erun.Run), even when
# nothing else about the run changed -- so a routine push otherwise always
# leaves this one-line bookkeeping diff sitting uncommitted afterward,
# needing a manual follow-up commit every single time. This repo's own
# git history already has a long-standing convention for exactly that
# follow-up commit ("Record latest android_ui_result (passing run)",
# `git log --grep`); auto-committing it here just does that same step
# without needing a human to type it by hand after every push.
#
# This can NOT ride along with the *current* push, despite running before
# it: git captures the exact local sha1 to push (the "local ref" line on
# this hook's own stdin) before invoking pre-push at all, and pushes
# exactly that captured value regardless of what HEAD moves to while the
# hook is still running -- confirmed directly (a commit made here stayed
# local-only; origin/main only caught up on the *next* push). So this
# commit is always exactly one push behind -- harmless and self-healing,
# since it becomes an ordinary ancestor of whatever real commit comes
# next and rides along with *that* push instead, but genuinely one more
# `git push` if this repo is ever left at just this commit with nothing
# else queued behind it.
#
# Deliberately narrow: only auto-commits when test/e2e/testdata.json is
# the *only* tracked file with a pending change (staged or not -- covered
# by the plain grep below rather than matching one exact `git status
# --porcelain` status-code string, since that same file can legitimately
# show up as "M ", " M", or "MM" depending on what's already staged), so a
# push made mid-way through unrelated work never gets a surprise commit
# mixed into it -- that case is left for the operator to sort out and
# commit themselves.
other_dirty=$(git status --porcelain --untracked-files=no | grep -v ' test/e2e/testdata\.json$')
testdata_dirty=$(git status --porcelain --untracked-files=no | grep ' test/e2e/testdata\.json$')
if [ -n "$testdata_dirty" ] && [ -z "$other_dirty" ]; then
	git add test/e2e/testdata.json
	commit_log=$(mktemp)
	if git commit -m "Record latest android_ui_result (passing run)" >"$commit_log" 2>&1; then
		echo "pre-push: auto-committed the refreshed android_ui_result timestamp"
	elif grep -q "Please tell me who you are" "$commit_log"; then
		# No git identity configured at all -- never set one globally from
		# a hook (or anywhere else automated); instead borrow whoever
		# authored the most recent commit, the same identity a human would
		# already be pushing this branch under anyway.
		author=$(git log -1 --format='%an <%ae>' HEAD)
		name=$(printf '%s' "$author" | sed 's/ <.*//')
		email=$(printf '%s' "$author" | sed 's/.*<\(.*\)>.*/\1/')
		if git -c "user.name=$name" -c "user.email=$email" commit -m "Record latest android_ui_result (passing run)" >"$commit_log" 2>&1; then
			echo "pre-push: auto-committed the refreshed android_ui_result timestamp (as $author -- no git identity configured)"
		else
			echo "pre-push: failed to auto-commit test/e2e/testdata.json -- commit it yourself before pushing again:" >&2
			cat "$commit_log" >&2
			rm -f "$commit_log"
			exit 1
		fi
	else
		echo "pre-push: failed to auto-commit test/e2e/testdata.json -- commit it yourself before pushing again:" >&2
		cat "$commit_log" >&2
		rm -f "$commit_log"
		exit 1
	fi
	rm -f "$commit_log"
elif [ -n "$testdata_dirty" ]; then
	echo "pre-push: test/e2e/testdata.json (and possibly other files) changed after e2e:current -- not auto-committing since other changes are also pending; commit test/e2e/testdata.json yourself before pushing again." >&2
fi

exit 0
