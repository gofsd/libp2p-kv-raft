prompts
*.log
*.key

# Claude Code's per-repo state: machine-local settings, its worktree
# checkouts and a scheduler lock file, none of which describe this project.
.claude/

# go build ./... writes a binary per main package into the repo root/cmd
# dirs unless -o is given; these are never meant to be committed.
/kvnode
/kvctl-cli
/cmd/kvnode/kvnode
/cmd/kvctl-cli/kvctl-cli

# pkg/e2erun's cross-compiled/native binaries for the e2e deploy pipeline.
/.e2e-build/

# mage build's cross-compiled release binaries (BuildLinux/BuildWindows).
/dist/

# cmd/relayrepro's own compiled binary -- a debug repro tool, never
# meant to be committed, same reasoning as /kvnode, /kvctl-cli above.
/relayrepro

# cmd/kvhttp's secondary-listener content root -- deployment-specific,
# copied onto the deployed host by hand (e.g. scp), never committed and
# never part of the build. See staticDir's doc comment in
# cmd/kvhttp/main.go.
/cmd/kvhttp/static/

# Android app build outputs / local machine config (regenerated by gradle/gomobile)
android-app/app/build/
android-app/.gradle/
android-app/.kotlin/
android-app/local.properties
android-app/app/libs/

# Release signing material -- never commit the keystore or its passwords.
android-app/keystore.properties
android-app/keystore/

# web-app build outputs / dependencies (regenerated by npm/cargo/wasm-pack)
web-app/node_modules/
web-app/dist/
web-app/pkg/
web-app/target/
web-app/test-results/
web-app/playwright-report/